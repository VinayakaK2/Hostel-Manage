DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hostel_manage?schema=public"

# Optional: full URL to your LOCAL Postgres (with password) for scripts/sync-local-to-remote-db.ps1
# LOCAL_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/hostel_manage"

# From your PC, Render's Internal DB URL will not resolve — use External URL from Render dashboard, or omit and let the sync script derive .singapore-postgres.render.com from DATABASE_URL.
# RENDER_EXTERNAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST.singapore-postgres.render.com/DATABASE?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
